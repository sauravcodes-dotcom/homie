# Copy to .env (repo root or backend/) and fill in. Never commit .env.

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://homie:homie@localhost:5432/homie
CORS_ORIGINS=http://localhost:5173

# AI providers: "mock"/"hashing" run fully offline (no key needed).
# Set to "openai" and add a key to use a real model.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
# Changing this after tables exist requires recreating the vector columns.
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (OpenAI, vLLM, Ollama, gateways).
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Frontend (frontend/.env.local) ---
# Leave empty in dev: Vite proxies /api to http://localhost:8000.
# Set to the deployed API origin for production builds.
VITE_API_URL=

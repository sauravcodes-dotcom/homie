# Copy to .env (repo root or backend/) and fill in. Never commit .env.

# --- Backend ---
ENVIRONMENT=development
# postgres:// URLs from hosted providers (Neon, Supabase) work as-is.
# Unset on Vercel = temporary SQLite demo storage that resets periodically.
DATABASE_URL=postgresql+psycopg://homie:homie@localhost:5432/homie
SEED_DEMO_DATA=true
# Number of generated demo listings around USC (0 disables bulk demo data).
DEMO_LISTING_COUNT=3000
CORS_ORIGINS=http://localhost:3000

# AI providers: "mock"/"hashing" run fully offline (no key needed).
# Set to "openai" and add a key to use a real model.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
# Changing this after tables exist requires recreating the vector columns.
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (OpenAI, vLLM, Ollama, gateways).
OPENAI_BASE_URL=https://api.openai.com/v1

# Sign-in: only @usc.edu addresses. Set a long random SECRET_KEY in production.
SECRET_KEY=
# With a Resend key, login codes are emailed. Without one (and AUTH_DEMO_MODE=true)
# the code is shown on screen, labeled demo mode.
# Email for sign-in codes. Easiest free option: a Gmail account + app password
# (Google Account > Security > 2-Step Verification > App passwords). ~500 emails/day.
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional overrides (defaults shown):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM_NAME=HOMIE
# Alternative: Resend (needs a verified domain to email anyone but yourself).
RESEND_API_KEY=
EMAIL_FROM=HOMIE <onboarding@resend.dev>
AUTH_DEMO_MODE=true

# Comma-separated emails allowed to approve verified-resident requests (/admin).
ADMIN_EMAILS=

# Listing photos and residency documents are stored on local disk here. Serverless
# hosts only keep /tmp, so production needs object storage for these to persist.
UPLOAD_DIR=uploads

# Buildings with fewer HOMIE reviews than this show a summary of public reviews instead.
MIN_REVIEWS_FOR_INSIGHTS=5
# none    = fallback off.
# places  = Google Places API (official, but returns at most 5 reviews per place).
# serpapi = SerpApi Google Maps reviews (paid third party; pages far enough for a
#           random sample of 100).
EXTERNAL_REVIEWS_PROVIDER=none
EXTERNAL_REVIEWS_SAMPLE_SIZE=100
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=

# --- Frontend ---
# Next.js dev server forwards /api to http://localhost:8000. Set API_PROXY to point
# it somewhere else. On Vercel, vercel.json routes /api to the backend service.
API_PROXY=
